# ── AgricFi Discord Bot — Environment Variables ──
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Discord Bot Token
# Get from: discord.com/developers/applications → Your App → Bot → Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel ID for wallet submissions
# Right-click the #get-test-sol channel → Copy Channel ID
FAUCET_CHANNEL_ID=your_channel_id_here

# Discord Guild (Server) ID
# Right-click your server name → Copy Server ID
GUILD_ID=your_guild_id_here

# Bot operator role ID (optional — restrict who can use admin commands)
ADMIN_ROLE_ID=your_admin_role_id_here

# Solana faucet wallet private key (base58 encoded)
# This wallet must have devnet SOL to distribute
# Generate with: solana-keygen new --outfile faucet-wallet.json
# Fund with: solana airdrop 10 <WALLET_ADDRESS> --url devnet
FAUCET_PRIVATE_KEY=your_faucet_wallet_private_key_base58

# Amount of devnet SOL to send per request
SOL_AMOUNT=1

# Cooldown in hours — prevents same wallet requesting twice quickly
COOLDOWN_HOURS=24

# Solana RPC endpoint (devnet)
SOLANA_RPC=https://api.devnet.solana.com
